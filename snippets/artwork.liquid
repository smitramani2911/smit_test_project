{%- if artwork_large != blank -%}
  <img
    src="{{ artwork_large | asset_url }}"
    srcset="{{ artwork_small | asset_url }} {{ artwork_small_width }}w, {{ artwork_large | asset_url }} {{ artwork_width }}w"
    sizes="{{ sizes | default: '100vw' }}"
    width="{{ artwork_width }}"
    height="{{ artwork_height }}"
    alt="{{ artwork_alt | escape }}"
    loading="{{ loading | default: 'lazy' }}"
    fetchpriority="{{ fetchpriority | default: 'auto' }}"
    decoding="async"
    {% if class != blank %}
      class="{{ class }}"
    {% endif %}
    {% if style != blank %}
      style="{{ style }}"
    {% endif %}
  >
{%- endif -%}
